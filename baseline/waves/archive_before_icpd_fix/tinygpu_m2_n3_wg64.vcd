$var reg 33 =% waves_dispatched [32:0] $end
$var reg 32 >% workgroup_cursor [31:0] $end
$var integer 32 ?% lane_comb [31:0] $end
$upscope $end
$scope module u_retire_controller $end
$var wire 3 @% all_counters_zero_mask [2:0] $end
$var wire 3 A% done_mask [2:0] $end
$var wire 3 B% retire_eligible_mask [2:0] $end
$var wire 1 v" wave_completed $end
$var parameter 32 C% NUM_WAVE_CONTEXTS $end
$var parameter 32 D% WAVE_ID_BITS $end
$var reg 1 4 release_valid $end
$var reg 2 E% release_wave_id [1:0] $end
$var integer 32 F% retire_scan_comb [31:0] $end
$upscope $end
$scope module u_scheduler $end
$var wire 1 R clk $end
$var wire 3 G% ready_mask [2:0] $end
$var wire 1 q rst_n $end
$var wire 1 H% schedule_fire $end
$var wire 1 s selected_ready $end
$var wire 2 I% round_robin_pointer_nxt [1:0] $end
$var parameter 32 J% NUM_WAVE_CONTEXTS $end
$var parameter 32 K% WAVE_ID_BITS $end
$var reg 1 L% candidate_valid $end
$var reg 2 M% candidate_wave_id [1:0] $end
$var reg 1 N% locked $end
$var reg 2 O% locked_wave_id [1:0] $end
$var reg 2 P% round_robin_pointer [1:0] $end
$var reg 1 * selected_valid $end
$var reg 2 Q% selected_wave_id [1:0] $end
$var integer 32 R% index_comb [31:0] $end
$var integer 32 S% scan_comb [31:0] $end
$upscope $end
$upscope $end
