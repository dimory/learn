$var parameter 32 /% THREAD_COUNT_BITS $end
$var parameter 32 0% WAVE_SIZE $end
$var parameter 33 1% WAVE_SIZE_EXTENDED $end
$var parameter 32 2% WG_WAVE_COUNT_BITS $end
$var parameter 32 3% WG_WAVE_ID_BITS $end
$var parameter 32 4% WORKGROUP_ID_BITS $end
$var reg 1 5% dispatch_finished $end
$var reg 2 6% dispatcher_state [1:0] $end
$var reg 2 7% dispatcher_state_next [1:0] $end
$var reg 64 8% initial_exec_comb [63:0] $end
$var reg 64 9% saved_start_pc [63:0] $end
